/* ============================================================================
 *  verify-assumptions.psjs — перевірка UXP-боку place.js.
 *
 *  ЯК ЗАПУСТИТИ
 *    Photoshop → File → Scripts → Browse… → вибрати цей файл.
 *
 *  ЩО ЦЕ ДАЄ І ЧОГО ТУТ БІЛЬШЕ НЕМА
 *    Раніше цей скрипт перевіряв усі передумови place.js. Тепер вісім із них
 *    ВЖЕ ПЕРЕВІРЕНО в Photoshop 27.5.0 через Action Manager (ExtendScript —
 *    той самий шар, що й batchPlay, лише інший фасад). Звіти лежать у
 *    scratchpad/psverify/probe*.txt, підсумок — у README.
 *
 *    Лишилися рівно дві речі, яких тим шляхом дістати НЕ можна:
 *      A. чи batchPlay-обгортка UXP передає ті самі descriptor-и, що
 *         executeAction (JSON → ActionDescriptor: _unit/_obj/_enum);
 *      B. модуль imaging — його в ExtendScript немає взагалі.
 *
 *    Метрика та сама: residual мусить бути 0 у кожному рядку.
 *
 *  ⚠️ ТЕСТ 8 МОЖЕ ПОВАЛИТИ PHOTOSHOP — це його очікуваний результат
 *     (imaging.getPixels у CMYK). Вимкнений. Щоб увімкнути — RUN_CMYK_CRASH_TEST
 *     = true і спершу збережіть роботу. Звіт пишеться на диск ДО цього тесту.
 * ========================================================================== */

const RUN_CMYK_CRASH_TEST = false;

const { app, core, constants, imaging } = require('photoshop');
const { batchPlay } = require('photoshop').action;
const fs = require('uxp').storage.localFileSystem;
const formats = require('uxp').storage.formats;

const log = [];
const say = s => { console.log(s); log.push(String(s)); };
const n4 = v => (v === null || v === undefined) ? 'null' : String(Math.round(v * 10000) / 10000);
const fmt = f => f ? `L${n4(f.left)} T${n4(f.top)} R${n4(f.right)} B${n4(f.bottom)} ` +
                     `(${n4(f.right - f.left)}×${n4(f.bottom - f.top)})` : 'null';

/* ── мінімальний PNG (stored deflate — файл маленький) ─────────────────────── */

const CRC = (() => {
    const t = new Uint32Array(256);
    for (let n = 0; n < 256; n++) {
        let c = n;
        for (let k = 0; k < 8; k++) c = (c & 1) ? (0xEDB88320 ^ (c >>> 1)) : (c >>> 1);
        t[n] = c >>> 0;
    }
    return t;
})();
const crc32 = b => {
    let c = 0xFFFFFFFF;
    for (let i = 0; i < b.length; i++) c = (CRC[(c ^ b[i]) & 0xFF] ^ (c >>> 8)) >>> 0;
    return (c ^ 0xFFFFFFFF) >>> 0;
};
const adler32 = b => {
    let s1 = 1, s2 = 0;
    for (let i = 0; i < b.length; i++) { s1 = (s1 + b[i]) % 65521; s2 = (s2 + s1) % 65521; }
    return ((s2 << 16) | s1) >>> 0;
};
const w32 = (a, o, v) => { a[o]=(v>>>24)&255; a[o+1]=(v>>>16)&255; a[o+2]=(v>>>8)&255; a[o+3]=v&255; };
function chunk(type, data) {
    const n = data.length, out = new Uint8Array(12 + n);
    w32(out, 0, n);
    for (let i = 0; i < 4; i++) out[4 + i] = type.charCodeAt(i);
    if (n) out.set(data, 8);
    const cb = new Uint8Array(4 + n);
    for (let i = 0; i < 4; i++) cb[i] = type.charCodeAt(i);
    if (n) cb.set(data, 4);
    w32(out, 8 + n, crc32(cb));
    return out;
}
/** RGB із контрастною рамкою 50 px — обрізання по канві видно на око. */
function makePng(w, h, ppi) {
    const rowBytes = w * 3, filtLen = h * (1 + rowBytes);
    const filt = new Uint8Array(filtLen);
    for (let y = 0; y < h; y++) {
        const o = y * (1 + rowBytes);
        for (let x = 0; x < w; x++) {
            const edge = x < 50 || y < 50 || x >= w - 50 || y >= h - 50;
            filt[o + 1 + x*3]     = edge ? 255 : 40;
            filt[o + 1 + x*3 + 1] = edge ? 0   : 90;
            filt[o + 1 + x*3 + 2] = edge ? 0   : 200;
        }
    }
    const MAX = 65535, nb = Math.max(1, Math.ceil(filtLen / MAX));
    const defl = new Uint8Array(2 + nb*5 + filtLen + 4);
    let p = 0;
    defl[p++] = 0x78; defl[p++] = 0x01;
    for (let b = 0; b < nb; b++) {
        const off = b*MAX, len = Math.min(MAX, filtLen - off);
        defl[p++] = b === nb-1 ? 1 : 0;
        defl[p++] = len & 255; defl[p++] = (len>>>8) & 255;
        defl[p++] = (~len) & 255; defl[p++] = ((~len)>>>8) & 255;
        defl.set(filt.subarray(off, off+len), p); p += len;
    }
    const ad = adler32(filt);
    defl[p++]=(ad>>>24)&255; defl[p++]=(ad>>>16)&255; defl[p++]=(ad>>>8)&255; defl[p]=ad&255;

    const ihdr = new Uint8Array(13);
    w32(ihdr, 0, w); w32(ihdr, 4, h); ihdr[8] = 8; ihdr[9] = 2;
    const parts = [new Uint8Array([137,80,78,71,13,10,26,10]), chunk('IHDR', ihdr)];
    if (ppi) {
        const d = new Uint8Array(9), ppm = Math.round(ppi * 39.3700787);
        w32(d, 0, ppm); w32(d, 4, ppm); d[8] = 1;
        parts.push(chunk('pHYs', d));
    }
    parts.push(chunk('IDAT', defl), chunk('IEND', new Uint8Array(0)));
    let total = 0; for (const x of parts) total += x.length;
    const png = new Uint8Array(total);
    let o = 0; for (const x of parts) { png.set(x, o); o += x.length; }
    return png;
}

/* ── ТОЧНІ КОПІЇ примітивів place.js. Якщо тут residual 0 — batchPlay
 *    передає descriptor-и так само, як executeAction. ─────────────────────── */

const PX = v => ({ _unit: 'pixelsUnit', _value: v });
const unwrap = n => (n && typeof n === 'object' && '_value' in n) ? n._value : n;

async function readSoFrame() {
    let res;
    try {
        res = await batchPlay([{
            _obj: 'get',
            _target: [
                { _ref: 'layer', _enum: 'ordinal', _value: 'targetEnum' },
                { _ref: 'document', _enum: 'ordinal', _value: 'targetEnum' },
            ],
        }], {});
    } catch (e) { return null; }
    const more = res && res[0] && res[0].smartObjectMore;
    if (!more || !more.transform || more.transform.length < 8) return null;
    const q = Array.prototype.slice.call(more.transform, 0, 8).map(unwrap);
    if (q.some(v => typeof v !== 'number' || !isFinite(v))) return null;
    const xs = [q[0], q[2], q[4], q[6]], ys = [q[1], q[3], q[5], q[7]];
    let skewed = false;
    if (more.nonAffineTransform && more.nonAffineTransform.length >= 8) {
        const n = Array.prototype.slice.call(more.nonAffineTransform, 0, 8).map(unwrap);
        for (let i = 0; i < 8; i++) if (Math.abs(n[i] - q[i]) > 0.001) { skewed = true; break; }
    }
    return {
        left: Math.min.apply(null, xs), right: Math.max.apply(null, xs),
        top: Math.min.apply(null, ys), bottom: Math.max.apply(null, ys),
        size: more.size ? { w: unwrap(more.size.width), h: unwrap(more.size.height) } : null,
        skewed,
    };
}
async function scaleSo(pw, ph) {
    const interp = (pw >= 100 || ph >= 100) ? 'bicubicSmoother' : 'bicubicSharper';
    await batchPlay([{
        _obj: 'transform',
        _target: [{ _ref: 'layer', _enum: 'ordinal', _value: 'targetEnum' }],
        freeTransformCenterState: { _obj: 'quadCenterState', _enum: 'quadCenterState', _value: 'QCSAverage' },
        width:  { _unit: 'percentUnit', _value: pw },
        height: { _unit: 'percentUnit', _value: ph },
        interpolation: { _enum: 'interpolationType', _value: interp },
        _options: { dialogOptions: 'dontDisplay' },
    }], {});
}
async function moveSo(dx, dy) {
    const h = Math.round(dx), v = Math.round(dy);
    if (h === 0 && v === 0) return;
    await batchPlay([{
        _obj: 'move',
        _target: [{ _ref: 'layer', _enum: 'ordinal', _value: 'targetEnum' }],
        to: { _obj: 'offset', horizontal: PX(h), vertical: PX(v) },
        _options: { dialogOptions: 'dontDisplay' },
    }], {});
}
async function placeFile(file) {
    const token = fs.createSessionToken(file);
    await batchPlay([{
        _obj: 'placeEvent',
        null: { _path: token, _kind: 'local' },
        linked: false,
        freeTransformCenterState: { _obj: 'quadCenterState', _enum: 'quadCenterState', _value: 'QCSAverage' },
        offset: { _obj: 'offset', horizontal: PX(0), vertical: PX(0) },
        _options: { dialogOptions: 'dontDisplay' },
    }], {});
}

/* геометрія — та сама арифметика, що в geometry.js */
function integerTarget(b) {
    const left = Math.round(b.left), top = Math.round(b.top);
    const right = Math.round(b.right), bottom = Math.round(b.bottom);
    return { left, top, right, bottom, w: right - left, h: bottom - top };
}
function planFrame(t, nat) {
    const aspectErr = Math.abs((t.w / t.h) / (nat.w / nat.h) - 1);
    if (aspectErr <= 0.005) return { mode: 'exact', left: t.left, top: t.top, right: t.right, bottom: t.bottom };
    const s = Math.max(t.w / nat.w, t.h / nat.h);
    const fw = Math.round(nat.w * s), fh = Math.round(nat.h * s);
    const left = t.left + Math.round((t.w - fw) / 2);
    const top  = t.top  + Math.round((t.h - fh) / 2);
    return { mode: 'cover', left, top, right: left + fw, bottom: top + fh };
}

async function writePng(name, bytes) {
    const folder = await fs.getTemporaryFolder();
    const f = await folder.createFile(name, { overwrite: true });
    await f.write(bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength),
                  { format: formats.binary });
    return f;
}
async function getPref() {
    try {
        const r = await batchPlay([{ _obj: 'get', _target: [
            { _ref: 'property', _property: 'generalPreferences' },
            { _ref: 'application', _enum: 'ordinal', _value: 'targetEnum' }] }], {});
        const v = r && r[0] && r[0].generalPreferences && r[0].generalPreferences.resizePastePlace;
        return typeof v === 'boolean' ? v : null;
    } catch (e) { return null; }
}
async function setPref(value) {
    try {
        await batchPlay([{ _obj: 'set', _target: [
            { _ref: 'property', _property: 'generalPreferences' },
            { _ref: 'application', _enum: 'ordinal', _value: 'targetEnum' }],
            to: { _obj: 'generalPreferences', resizePastePlace: value } }], {});
    } catch (e) {}
}

/* ── прогін ───────────────────────────────────────────────────────────────── */

async function run() {
    const M = constants.NewDocumentMode;
    const D = constants.BitsPerChannelType;

    say('=== A. batchPlay-паритет: чи UXP передає ті самі descriptor-и ===');
    say(`Photoshop ${app.version}`);
    const open = app.documents.length;
    say(`відкритих документів: ${open} — скрипт їх не чіпає`);

    const fileSq = await writePng('vt_sq.png',  makePng(1024, 1024, 300));
    const fileWd = await writePng('vt_wd.png',  makePng(1000, 600, 300));

    const prefWas = await getPref();
    if (prefWas === true) await setPref(false);

    const CASES = [
        { tag: 'RGB8 300  парне 200×200',   mode: M.RGB,  depth: D.EIGHT,   w: 2000, h: 1500, res: 300, file: fileSq, nat: {w:1024,h:1024}, b: {left:400, top:300, right:600, bottom:500} },
        { tag: 'RGB8 300  НЕПАРНЕ 201×201', mode: M.RGB,  depth: D.EIGHT,   w: 2000, h: 1500, res: 300, file: fileSq, nat: {w:1024,h:1024}, b: {left:333, top:277, right:534, bottom:478} },
        { tag: 'RGB8 300  дробові межі',    mode: M.RGB,  depth: D.EIGHT,   w: 2000, h: 1500, res: 300, file: fileSq, nat: {w:1024,h:1024}, b: {left:332.6, top:276.4, right:533.5, bottom:477.5} },
        { tag: 'RGB8 300  cover 400×400',   mode: M.RGB,  depth: D.EIGHT,   w: 2000, h: 1500, res: 300, file: fileWd, nat: {w:1000,h:600},  b: {left:700, top:500, right:1100, bottom:900} },
        { tag: 'RGB8 300  поза канвою',     mode: M.RGB,  depth: D.EIGHT,   w: 2000, h: 1500, res: 300, file: fileSq, nat: {w:1024,h:1024}, b: {left:1850, top:1400, right:2150, bottom:1700} },
        { tag: 'CMYK8 300 НЕПАРНЕ',         mode: M.CMYK, depth: D.EIGHT,   w: 2000, h: 1500, res: 300, file: fileSq, nat: {w:1024,h:1024}, b: {left:333, top:277, right:534, bottom:478} },
        { tag: 'CMYK16 300 НЕПАРНЕ',        mode: M.CMYK, depth: D.SIXTEEN, w: 2000, h: 1500, res: 300, file: fileSq, nat: {w:1024,h:1024}, b: {left:333, top:277, right:534, bottom:478} },
        { tag: 'RGB16 72  НЕПАРНЕ',         mode: M.RGB,  depth: D.SIXTEEN, w: 800,  h: 600,  res: 72,  file: fileSq, nat: {w:1024,h:1024}, b: {left:251, top:131, right:452, bottom:332} },
    ];

    let good = 0, converted = [];
    for (const c of CASES) {
        let doc = null;
        try {
            doc = await app.documents.add({ name: 'VT', width: c.w, height: c.h, resolution: c.res,
                mode: c.mode, fill: constants.DocumentFill.WHITE, depth: c.depth });
            const modeBefore = String(doc.mode), bpcBefore = doc.bitsPerChannel;

            const target = integerTarget(c.b);
            const dst = planFrame(target, c.nat);
            const tw = dst.right - dst.left, th = dst.bottom - dst.top;

            await placeFile(c.file);
            try { await batchPlay([{ _obj: 'placedLayerResetTransforms',
                _options: { dialogOptions: 'dontDisplay' } }], {}); } catch (e) {}

            let cur = await readSoFrame();
            const lines = [`після reset ${fmt(cur)}`];
            const hit = f => f && Math.abs(dst.left - f.left) < 0.01 && Math.abs(dst.top - f.top) < 0.01
                          && Math.abs(tw - (f.right - f.left)) < 0.01
                          && Math.abs(th - (f.bottom - f.top)) < 0.01;
            let passes = 0;
            for (let pass = 0; pass < 2 && cur && !hit(cur); pass++) {
                passes++;
                const cw = cur.right - cur.left, ch = cur.bottom - cur.top;
                if (cw < 0.005 || ch < 0.005) break;
                const pw = tw / cw * 100, ph = th / ch * 100;
                if (Math.abs(pw - 100) > 1e-9 || Math.abs(ph - 100) > 1e-9) {
                    await scaleSo(pw, ph);
                    cur = await readSoFrame();
                    lines.push(`масштаб ${fmt(cur)}  pw=${n4(pw)}% ph=${n4(ph)}%`);
                }
                await moveSo(dst.left - cur.left, dst.top - cur.top);
                cur = await readSoFrame();
                lines.push(`зсув    ${fmt(cur)}`);
            }
            const modeAfter = String(app.activeDocument.mode);
            const bpcAfter = app.activeDocument.bitsPerChannel;
            const conv = modeBefore !== modeAfter || bpcBefore !== bpcAfter;
            if (conv) converted.push(c.tag);

            const res = cur ? {
                dx: dst.left - cur.left, dy: dst.top - cur.top,
                dw: tw - (cur.right - cur.left), dh: th - (cur.bottom - cur.top),
            } : null;
            const ok = res && Math.abs(res.dx) < 0.01 && Math.abs(res.dy) < 0.01
                           && Math.abs(res.dw) < 0.01 && Math.abs(res.dh) < 0.01;
            if (ok) good++;

            say('');
            say(`  ${c.tag}`);
            say(`      ціль [${dst.mode}] ${fmt(dst)}`);
            for (const l of lines) say(`      ${l}`);
            say(`      residual ${res ? `dx=${n4(res.dx)} dy=${n4(res.dy)} dw=${n4(res.dw)} dh=${n4(res.dh)}` : 'не виміряний'}` +
                `  => ${ok ? 'ТОЧНО' : 'ЗСУВ'} | проходів ${passes}` +
                ` | нативний растр ${cur && cur.size ? `${n4(cur.size.w)}×${n4(cur.size.h)}` : '?'}` +
                ` | перекіс ${cur ? cur.skewed : '?'}` +
                ` | документ ${modeAfter}/${bpcAfter}${conv ? ' ← СКОНВЕРТОВАНО!' : ''}`);

            await doc.closeWithoutSaving(); doc = null;
        } catch (e) {
            say(`  ${c.tag} — ПОМИЛКА: ${e.message}`);
            if (doc) { try { await doc.closeWithoutSaving(); } catch (e2) {} }
        }
    }
    if (prefWas === true) await setPref(true);

    say('');
    say(`ПІДСУМОК A: ${good}/${CASES.length} точно` +
        (converted.length ? `; СКОНВЕРТОВАНО: ${converted.join(', ')}` : '; жоден документ не сконвертовано'));
    if (good < CASES.length) {
        say('  ⚠️ Якщо через ExtendScript ті самі кейси давали 0 (див. probe6.txt), а тут ні —');
        say('     різниця саме в обгортці batchPlay: перевірте _unit/_obj у scaleSo/moveSo.');
    }

    /* ── B. imaging: чого з ExtendScript не видно ───────────────────────── */
    say('');
    say('=== B. imaging — модуль, якого в ExtendScript немає ===');

    let d3 = null;
    try {
        d3 = await app.documents.add({ name: 'VT16', width: 400, height: 300, resolution: 72,
            mode: M.RGB, fill: constants.DocumentFill.WHITE, depth: D.SIXTEEN });
        try {
            const px = await imaging.getPixels({
                sourceBounds: { left: 0, top: 0, right: 64, bottom: 64 },
                colorSpace: 'RGB', colorProfile: 'sRGB IEC61966-2.1',
                componentSize: 8, applyAlpha: false,
            });
            const data = await px.imageData.getData();
            say(`  [7] getPixels componentSize:8 з 16-бітного документа: ПРАЦЮЄ — ` +
                `${px.imageData.components} комп., componentSize ${px.imageData.componentSize}, ` +
                `${data.length} байтів. Прямий шлях capture.js достатній, дублікат не потрібен.`);
            px.imageData.dispose();
        } catch (e) {
            say(`  [7] getPixels componentSize:8 з 16 біт: КИДАЄ «${e.message}» — ` +
                'відома регресія з PS 26.3. capture.js це переживає: тихо йде через дублікат.');
        }
        await d3.closeWithoutSaving(); d3 = null;
    } catch (e) {
        say(`  [7] не вдалось перевірити: ${e.message}`);
        if (d3) { try { await d3.closeWithoutSaving(); } catch (e2) {} }
    }

    /* звіт на диск ДО небезпечного тесту */
    let reportPath = '(не збережено)';
    try {
        const tmp = await fs.getTemporaryFolder();
        const rf = await tmp.createFile(`ai-image-ps-verify-${Date.now()}.txt`, { overwrite: true });
        await rf.write(log.join('\n'));
        reportPath = rf.nativePath;
    } catch (e) { reportPath = 'не вдалось: ' + e.message; }
    say('');
    say(`Звіт: ${reportPath}`);

    if (RUN_CMYK_CRASH_TEST) {
        say('');
        say('⚠️ [8] getPixels у CMYK — Photoshop може впасти, це очікуваний результат.');
        let d4 = null;
        try {
            d4 = await app.documents.add({ name: 'VTCMYK', width: 200, height: 200, resolution: 72,
                mode: M.CMYK, fill: constants.DocumentFill.WHITE, depth: D.EIGHT });
            const px = await imaging.getPixels({
                sourceBounds: { left: 0, top: 0, right: 16, bottom: 16 },
                colorSpace: 'RGB', colorProfile: 'sRGB IEC61966-2.1',
                componentSize: 8, applyAlpha: false,
            });
            const data = await px.imageData.getData();
            say(`  [8] НЕ впав, ${data.length} байтів — CMYK можна читати напряму, ` +
                'дублікат у capture.js стає непотрібним.');
            px.imageData.dispose();
            await d4.closeWithoutSaving();
        } catch (e) {
            say(`  [8] кинув «${e.message}» — принаймні gracefully. Дублікат потрібен.`);
            if (d4) { try { await d4.closeWithoutSaving(); } catch (e2) {} }
        }
    } else {
        say('  [8] getPixels у CMYK — тест вимкнено (RUN_CMYK_CRASH_TEST = false).');
        say('      capture.js CMYK через imaging не читає взагалі, тому для роботи це не критично.');
    }

    try { await fileSq.delete(); } catch (e) {}
    try { await fileWd.delete(); } catch (e) {}

    say('');
    say(`відкритих документів на виході: ${app.documents.length} (було ${open})`);
    say('=== кінець ===');

    try {
        const tmp = await fs.getTemporaryFolder();
        const rf = await tmp.createFile('ai-image-ps-verify-final.txt', { overwrite: true });
        await rf.write(log.join('\n'));
    } catch (e) {}

    await core.showAlert(`Перевірка UXP-боку завершена.\n\nA: ${good}/${CASES.length} точно` +
        `\n\nЗвіт: ${reportPath}\n\nДеталі — Plugins → Development → Show Console.`);
}

core.executeAsModal(run, { commandName: 'Перевірка UXP-боку place.js' })
    .catch(e => {
        console.error(e);
        core.showAlert('Перевірка обірвалась: ' + (e && e.message ? e.message : e));
    });
