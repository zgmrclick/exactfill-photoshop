{
  "id": "ai-image-ps",
  "name": "ExactFill",
  "version": "1.6.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "manifestVersion": 5,
  "requiredPermissions": {
    "localFileSystem": "request",
    "launchProcess": {
      "schemes": ["https"]
    },
    "network": {
      "domains": [
        "https://api.openai.com",
        "https://generativelanguage.googleapis.com"
      ]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "aiImagePanel",
      "minimumSize": { "width": 230, "height": 260 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 300, "height": 600 },
      "preferredFloatingSize": { "width": 320, "height": 680 },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-dark.png",
          "scale": [1, 2],
          "theme": ["medium", "dark", "darkest"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ],
      "label": { "default": "ExactFill" }
    }
  ],
  "icons": [
    {
      "width": 24,
      "height": 24,
      "path": "icons/exactfill.svg",
      "scale": [1, 2],
      "theme": ["lightest", "light", "medium", "dark", "darkest", "all"],
      "species": ["generic"]
    }
  ]
}
